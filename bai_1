#include <stdio.h>
#include <stdlib.h>
void nhap(float *a, int n){
	for (int i=0; i<n; i++){
		printf("Nhap phan tu thu %d: ",i+1);
		scanf("%f",a+i);
	}
}
void in(float *a, int n){
	for(int i=0; i<n; i++){
		printf("\nPhan tu thu %d la %.2f: ",i+1,*(a+i));
	}
}
int main(){
	int n;
	float *a=NULL;
	do{
		printf("Nhap so phan tu: ");
		scanf("%d",&n);
	}while(n<=0);
	a=(float*)malloc(n*sizeof(float));
	if(a==NULL){
		printf("Loi khong du bo nho: ");
		return 1;
	}
	nhap(a, n);
	printf("Mang vua nhap la: ");
	in(a,n);
	free(a);
	return 0;
}
