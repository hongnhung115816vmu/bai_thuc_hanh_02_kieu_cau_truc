#include <stdio.h>
#include <stdlib.h>
void nhap(float *a, int m, int n){
	for (int i=0; i<m; i++){
		for(int j=0; j<n; j++){
			printf("Nhap phan tu hang %d cot %d: ",i+1,j+1);
			scanf("%f",a+i*n+j);
		}
	}
}
void in(float *a, int m, int n){
	for(int i=0; i<m; i++){
		for(int j=0; j<n; j++){
			printf("%.2f\t", *(a + i * n + j));
		}
		printf("\n");
	}
}
int main(){
	int m,n;
	float *a=NULL;
	do{
		printf("Nhap so hang va cot: ");
		scanf("%d%d",&m,&n);
	}while(m<=0 || n<=0);
	a=(float*)malloc(m*n*sizeof(float));
	if(a==NULL){
		printf("Loi khong du bo nho");
		return 1;
	}
	nhap(a, m, n);
	printf("Mang vua nhap la");
	in(a, m, n);
	free(a);
	return 0;
}
