#include <stdio.h>
#include <stdlib.h>

typedef struct sv{
	int ma;
	char ten[100];
	float d1, d2, d3;
}sv;
int main(){
	int n;
	printf("Nhap so luong sinh vien: ");
	scanf("%d",&n);
	struct sv *ds=(struct sv*)malloc(n*sizeof(struct sv));
	for(int i=0;i<n; i++){
		printf("Sinh vien thu %d:\n",i+1);
		printf("Nhap ma sv:");
		scanf("%d",&ds[i].ma);
		printf("Nhap ho ten sv:");
		getchar();
		gets(ds[i].ten);
		printf("Nhap diem ba mon:");
		scanf("%f%f%f",&ds[i].d1, &ds[i].d2, &ds[i].d3);
	}
	printf("Danh sach sinh vien vua nhap la:\n");
	for(int i=0; i<n; i++){
		printf("%d %s %.2f %.2f %.2f\n",ds[i].ma, ds[i].ten, ds[i].d1, ds[i].d2, ds[i].d3);
	}
	free(ds);
	return 0;
}
